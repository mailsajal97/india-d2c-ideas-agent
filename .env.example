# Copy this file to .env and fill in your keys.
# Setup will write this for you automatically — you should not need to edit by hand.

# Exa API key — get one free at https://exa.ai (1,000 requests/month free tier)
EXA_API_KEY=your_exa_key_here

# Anthropic API key — REQUIRED. The skill's Python scripts call Claude via the
# Anthropic SDK from a separate process. Your Claude Pro/Max subscription does
# NOT cover this — it bills from your Anthropic Console workspace (~$0.40-0.60
# per run). Get a key at https://console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-your_key_here
